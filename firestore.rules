rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string
        && data.userId.size() <= 128
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('completedSkills' in data) || (data.completedSkills is list && data.completedSkills.size() <= 200))
        && (!('skillProgress' in data) || (data.skillProgress is map))
        && (!('currentUnit' in data) || (data.currentUnit is string && data.currentUnit.size() <= 64))
        && (!('currentSkill' in data) || (data.currentSkill is string && data.currentSkill.size() <= 64))
        && (!('totalXP' in data) || (data.totalXP is number && data.totalXP >= 0))
        && (!('harvestedFruits' in data) || (data.harvestedFruits is list && data.harvestedFruits.size() <= 100))
        && (!('stamina' in data) || (data.stamina is number))
        && (!('streakDays' in data) || (data.streakDays is number))
        && (!('analytics' in data) || (data.analytics is map))
        && (!('aiConfig' in data) || (data.aiConfig is map))
        && (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().userId == request.auth.uid
                    && isValidUserProfile(incoming());
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().userId == request.auth.uid
                    && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
